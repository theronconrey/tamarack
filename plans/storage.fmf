# SPDX-License-Identifier: GPL-3.0-or-later
#
# The VM test matrix (docs/design/engine.md, section 10). Runs on Testing
# Farm through Packit, or locally with `tmt run` (it provisions a VM).
# Three plans, three VMs: Testing Farm runs each plan on its own machine,
# in parallel, so the matrix takes as long as its slowest group (about 25
# minutes of tests) instead of all of them in a row.
# Every test runs with SELinux enforcing, on RAM-backed scsi_debug drives
# or file-backed LIO loopback drives created inside the VM, so nothing
# outside the VM can ever be touched.

summary: Engine on a real kernel, SELinux enforcing
provision:
    how: virtual
    hardware:
        # scsi_debug keeps every drive in RAM: up to four 3 GB drives, which
        # md's resync and dm-integrity's wipe fill completely. With 8 GB the
        # VM ran out of memory and dropped the test's connection.
        memory: ">= 16 GB"
prepare:
  - name: Packages under test
    how: install
    package:
      - tamarack
      - tamarack-engine
      - tamarack-selinux
      - tamarack-cockpit
      - python3-gobject-base
execute:
    how: tmt

/build:
    summary: Create, grow, mixed sizes, shares, the Cockpit page, a reboot, recovery by hand
    discover:
        how: fmf
        filter: "tag:vm-build"

/failures:
    summary: A pulled drive, an online swap, the engine killed mid-reshape
    discover:
        how: fmf
        filter: "tag:vm-failures"

/integrity:
    summary: One drive then two, and silent corruption caught and repaired
    discover:
        how: fmf
        filter: "tag:vm-integrity"
