# SPDX-License-Identifier: GPL-3.0-or-later
#
# The VM test matrix (docs/design/engine.md, section 10). Runs on Testing
# Farm through Packit, or locally with `tmt run` (it provisions a VM).
# Every test runs with SELinux enforcing, on RAM-backed scsi_debug drives
# created inside the VM, so nothing outside the VM can ever be touched.

summary: Tamarack engine on real kernels, with SELinux enforcing
discover:
    how: fmf
    filter: tag:vm
provision:
    how: virtual
    hardware:
        memory: ">= 8 GB"
prepare:
  - name: Packages under test
    how: install
    package:
      - tamarack
      - tamarack-engine
      - tamarack-selinux
      - python3-gobject-base
execute:
    how: tmt
