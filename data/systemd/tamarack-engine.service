#
# Tamarack storage engine (docs/design/engine.md, section 8).
# The only privileged Tamarack component. Every relaxation of the sandbox
# below carries a comment saying why. It runs storage commands only when
# /etc/tamarack/engine.conf turns execution on.

[Unit]
Description=Tamarack storage engine
Documentation=man:tamarack(1) https://github.com/theronconrey/tamarack
Wants=udisks2.service upower.service
After=udisks2.service upower.service polkit.service
# The sandbox can't load kernel modules (ProtectKernelModules=yes), so the md
# personalities and dm-integrity are loaded before the engine starts.
Wants=modprobe@dm_integrity.service modprobe@raid1.service modprobe@raid456.service
After=modprobe@dm_integrity.service modprobe@raid1.service modprobe@raid456.service

[Service]
Type=dbus
BusName=io.github.theronconrey.Tamarack1
ExecStart=/usr/libexec/tamarack-engine

StateDirectory=tamarack
StateDirectoryMode=0700
UMask=0077

# Filesystem and process isolation
ProtectSystem=strict
# The storage tools keep locks and state here: mdadm in /run/mdadm, LVM in
# /run/lvm, /run/lock/lvm and /etc/lvm (metadata backups and the devices
# file), cryptsetup's integritysetup in /run/cryptsetup.
ReadWritePaths=-/run/mdadm -/run/lvm -/run/lock/lvm -/run/cryptsetup
ReadWritePaths=-/etc/lvm/archive -/etc/lvm/backup -/etc/lvm/devices
# The engine keeps its lines in /etc/integritytab, so the pool opens at boot.
ReadWritePaths=-/etc/integritytab
# The engine writes /etc/exports.d/tamarack.exports for NFS shares.
ReadWritePaths=-/etc/exports.d
# And makes NFS v4-only when the first share is made (written in place).
ReadWritePaths=-/etc/nfs.conf.d/tamarack.conf
# The volume itself: subvolumes and share folders.
ReadWritePaths=-/srv/tamarack
RuntimeDirectory=mdadm lvm lock/lvm cryptsetup
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# dm-integrity, raid1 and raid456 are loaded at boot by
# /usr/lib/modules-load.d/tamarack.conf, so the engine never loads modules.
ProtectKernelModules=yes
# mdadm writes md sysfs attributes (sync speed, reshape state).
ProtectKernelTunables=no
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
# RestrictSUIDSGID= stays off: share folders are setgid (mode 2775) so new
# files keep the share's group, and its filter refuses that with EPERM.

# The engine needs no network: D-Bus and udev only.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Raw block-device access is the engine's job, so PrivateDevices= stays off;
# DevicePolicy=closed limits it to the device classes below.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=block-sd rw
DeviceAllow=block-blkext rw
DeviceAllow=block-virtblk rw
# m: mdadm --create makes the new array's node itself (mknod) when the
# kernel does not create it on request; without it the device cgroup
# refuses the mknod and mdadm fails with "unexpected failure opening".
DeviceAllow=block-md rwm
DeviceAllow=block-device-mapper rw
DeviceAllow=/dev/mapper/control rw

# Partitioning, dm and md ioctls need CAP_SYS_ADMIN and CAP_SYS_RAWIO;
# creating device nodes needs CAP_MKNOD; state files need the rest.
# Restoring from a snapshot reads files their owners keep private:
# CAP_DAC_READ_SEARCH (read and search only, never write).
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RAWIO CAP_MKNOD CAP_DAC_OVERRIDE CAP_CHOWN CAP_DAC_READ_SEARCH
SystemCallArchitectures=native
SystemCallFilter=@system-service @raw-io
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
