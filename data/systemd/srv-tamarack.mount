#
# The Tamarack volume. Not enabled by the package: the engine enables and
# starts it (systemctl enable --now) as the last step of creating a pool,
# so it mounts at every boot from then on. Mounted by systemd in the host's
# namespace, not by the sandboxed engine.

[Unit]
Description=Tamarack storage volume
Documentation=https://github.com/theronconrey/tamarack

[Mount]
What=/dev/tamarack/data
Where=/srv/tamarack
Type=btrfs
# rootcontext: a new filesystem's root has no SELinux label (unlabeled_t)
# until something labels it; this gives it Tamarack's data label at every
# mount, and everything created below inherits it.
Options=compress=zstd:1,noatime,rootcontext=system_u:object_r:tamarack_data_t:s0

[Install]
WantedBy=multi-user.target
