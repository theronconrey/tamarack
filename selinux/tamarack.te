# SPDX-License-Identifier: GPL-3.0-or-later
#
# SELinux policy for the Tamarack storage engine (docs/design/engine.md,
# section 9). The engine runs in tamarack_engine_t. It does not touch disks
# itself: each storage tool it starts transitions into that tool's own
# Fedora domain (mdadm_t, lvm_t, fsadm_t; integritysetup is labelled
# lvm_exec_t in tamarack.fc), so the engine is never granted
# the tools' permissions. Written to run enforcing; the VM test matrix
# fails on any AVC denial.

policy_module(tamarack, 0.1.0)

########################################
#
# Declarations
#

type tamarack_engine_t;
type tamarack_engine_exec_t;
init_daemon_domain(tamarack_engine_t, tamarack_engine_exec_t)
# The unit sets NoNewPrivileges=yes; under it, systemd may only start the
# engine in its own domain if the policy allows the NNP transition.
init_nnp_daemon_domain(tamarack_engine_t)

type tamarack_unit_file_t;
systemd_unit_file(tamarack_unit_file_t)

# /var/lib/tamarack: layout, backup timestamp, job journals.
type tamarack_var_lib_t;
files_type(tamarack_var_lib_t)

# /etc/tamarack: the administrator's engine.conf.
type tamarack_etc_t;
files_config_file(tamarack_etc_t)

# /etc/integritytab: the engine keeps its lines there; systemd's
# integritysetup generator reads it at boot to open the pool's mappings.
type tamarack_integritytab_t;
files_config_file(tamarack_integritytab_t)

# tamarack-meta: writes the layout record to tk-meta partitions. The only
# Tamarack code with raw-disk access; it checks the partition label first.
type tamarack_meta_t;
type tamarack_meta_exec_t;
domain_type(tamarack_meta_t)
domain_entry_file(tamarack_meta_t, tamarack_meta_exec_t)
role system_r types tamarack_meta_t;

########################################
#
# The engine
#

allow tamarack_engine_t self:fifo_file rw_fifo_file_perms;
allow tamarack_engine_t self:unix_stream_socket create_stream_socket_perms;
allow tamarack_engine_t self:process { getsched signal_perms };

manage_dirs_pattern(tamarack_engine_t, tamarack_var_lib_t, tamarack_var_lib_t)
manage_files_pattern(tamarack_engine_t, tamarack_var_lib_t, tamarack_var_lib_t)
files_var_lib_filetrans(tamarack_engine_t, tamarack_var_lib_t, dir)

read_files_pattern(tamarack_engine_t, tamarack_etc_t, tamarack_etc_t)
rw_files_pattern(tamarack_engine_t, tamarack_integritytab_t, tamarack_integritytab_t)
list_dirs_pattern(tamarack_engine_t, tamarack_etc_t, tamarack_etc_t)
files_read_etc_files(tamarack_engine_t)

# Python and its libraries.
corecmd_exec_bin(tamarack_engine_t)
files_read_usr_files(tamarack_engine_t)
miscfiles_read_localization(tamarack_engine_t)
# GLib looks up root's home directory and the system certificate paths at
# start; harmless reads.
auth_read_passwd(tamarack_engine_t)
miscfiles_read_generic_certs(tamarack_engine_t)

# /proc and sysfs: md degraded counts behind /dev/md/tk-lN.
kernel_read_system_state(tamarack_engine_t)
dev_read_sysfs(tamarack_engine_t)
dev_list_all_dev_nodes(tamarack_engine_t)
dev_getattr_all_blk_files(tamarack_engine_t)

# The system bus: own com.borealislogistics.Tamarack1, talk to polkit,
# UDisks2, UPower and systemd (systemd-mount).
dbus_system_bus_client(tamarack_engine_t)
dbus_connect_system_bus(tamarack_engine_t)
allow tamarack_engine_t self:dbus send_msg;

optional_policy(`
	gen_require(`
		type system_dbusd_t;
	')
	allow tamarack_engine_t system_dbusd_t:dbus acquire_svc;
')

optional_policy(`
	policykit_dbus_chat(tamarack_engine_t)
')

optional_policy(`
	devicekit_dbus_chat_disk(tamarack_engine_t)
	devicekit_dbus_chat_power(tamarack_engine_t)
')

optional_policy(`
	init_dbus_chat(tamarack_engine_t)
')

# snapper is a D-Bus client of snapperd, which makes and prunes snapshots.
optional_policy(`
	gen_require(`
		type snapperd_t;
		class dbus send_msg;
	')
	allow tamarack_engine_t snapperd_t:dbus send_msg;
	allow snapperd_t tamarack_engine_t:dbus send_msg;
')

# systemctl enable --now srv-tamarack.mount, after creating a pool.
optional_policy(`
	systemd_exec_systemctl(tamarack_engine_t)
')

# The storage tools run in their own domains.
# NoNewPrivileges is inherited, so each of these transitions also needs
# nnp_transition (and nosuid_transition) to take effect.
optional_policy(`
	gen_require(`
		type mdadm_t;
		class process2 { nnp_transition nosuid_transition };
	')
	raid_domtrans_mdadm(tamarack_engine_t)
	allow tamarack_engine_t mdadm_t:process2 { nnp_transition nosuid_transition };
')

optional_policy(`
	gen_require(`
		type lvm_t;
		class process2 { nnp_transition nosuid_transition };
	')
	lvm_domtrans(tamarack_engine_t)
	allow tamarack_engine_t lvm_t:process2 { nnp_transition nosuid_transition };
')

optional_policy(`
	gen_require(`
		type fsadm_t;
		class process2 { nnp_transition nosuid_transition };
	')
	fstools_domtrans(tamarack_engine_t)
	allow tamarack_engine_t fsadm_t:process2 { nnp_transition nosuid_transition };
')

# Whichever domain runs systemd's generators must read /etc/integritytab.
optional_policy(`
	gen_require(`
		type init_t;
	')
	allow init_t tamarack_integritytab_t:file read_file_perms;
')

optional_policy(`
	gen_require(`
		type systemd_generator_t;
	')
	allow systemd_generator_t tamarack_integritytab_t:file read_file_perms;
')

domtrans_pattern(tamarack_engine_t, tamarack_meta_exec_t, tamarack_meta_t)
allow tamarack_engine_t tamarack_meta_t:process2 { nnp_transition nosuid_transition };

########################################
#
# tamarack-meta
#

allow tamarack_meta_t self:fifo_file rw_fifo_file_perms;
allow tamarack_meta_t tamarack_engine_t:fd use;
allow tamarack_meta_t tamarack_engine_t:fifo_file rw_fifo_file_perms;

corecmd_exec_bin(tamarack_meta_t)
files_read_usr_files(tamarack_meta_t)
files_read_etc_files(tamarack_meta_t)
miscfiles_read_localization(tamarack_meta_t)
# Python's start-up looks up the user and the OpenSSL configuration.
auth_read_passwd(tamarack_meta_t)
miscfiles_read_generic_certs(tamarack_meta_t)
kernel_read_system_state(tamarack_meta_t)
dev_read_sysfs(tamarack_meta_t)
dev_list_all_dev_nodes(tamarack_meta_t)
storage_raw_read_fixed_disk(tamarack_meta_t)
storage_raw_write_fixed_disk(tamarack_meta_t)
