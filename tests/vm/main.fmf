# SPDX-License-Identifier: GPL-3.0-or-later
tag: [vm]
duration: 30m
require:
  - kernel-modules-extra  # scsi_debug
  - audit
  - python3-gobject-base
  - nfs-utils  # the NFS client side of the nfs test
  - targetcli  # file-backed drives through LIO (tcm_loop)

/create-grow:
    summary: Create on two drives, grow to four
    test: ./create-grow.sh

/single:
    summary: One drive, then a second
    test: ./single.sh

/replace:
    summary: Swap a working drive while online
    test: ./replace.sh

/failed:
    summary: Rebuild after a drive disappears
    test: ./failed.sh

/corruption:
    summary: Silent corruption is caught and repaired
    test: ./corruption.sh

/interrupt:
    summary: Engine killed mid-reshape, then resumed
    test: ./interrupt.sh

/recover-by-hand:
    summary: Stock tools alone bring the volume back
    test: ./recover-by-hand.sh

/mixed:
    summary: Mixed sizes, leftover space paired later
    test: ./mixed.sh

/nfs:
    summary: Shares over NFSv4, squashing, read-only
    test: ./nfs.sh
